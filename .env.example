# Copy this file to .env or inject the variables through your deployment platform.
# Never commit the populated .env file.

# Required outside the local dev profile. Use at least 32 random bytes.
JWT_SECRET=

# MySQL / Redis. Public defaults point to localhost only.
DB_URL=jdbc:mysql://127.0.0.1:3306/smile_boss_ai?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Optional model providers. Leave disabled/empty when running the deterministic demo.
LLM_ENABLED=false
NICE_LLM_CHAT_PROVIDER=claude
CLAUDE_API_KEY=
CLAUDE_BASE_URL=
CLAUDE_MODEL=
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=

# Optional vector store.
VECTOR_ENABLED=false
QDRANT_URL=http://127.0.0.1:6333

# Optional DingTalk custom robot. Never place a real webhook in source control.
DINGTALK_ENABLED=false
DINGTALK_WEBHOOK=
DINGTALK_SECRET=
DINGTALK_KEYWORD=招聘审核
DINGTALK_APPROVAL_PAGE_URL=http://localhost:5173
